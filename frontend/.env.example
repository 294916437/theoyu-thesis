# WebRTC的信令服务器
# 开发环境使用相对路径，由 Vite proxy 转发到后端，避免 HTTPS 混合内容限制
# 生产环境设置绝对 wss:// 地址，例如：VITE_WS_SIGNALING_SERVER=wss://your-domain.com/message/ws/signal
VITE_WS_SIGNALING_SERVER=/message/ws/signal
# 聊天模式的Websocket连接地址
VITE_WS_MESSAGE_SERVER=/message/ws/chat
# 房间内聊天的WebSocket连接地址
VITE_WS_ROOM_MESSAGE_SERVER=/media/ws/room
# SFU提供的socket连接地址
# 开发环境留空，socket.io 走同源请求由 Vite proxy 转发（避免 HTTPS 混合内容问题）
# 生产环境设置为实际的 wss:// 地址，例如：VITE_SFU_URL=wss://your-domain.com
VITE_SFU_URL=
# 是否开启开发模式
VITE_DEV=true
# 局域网访问地址，开发模式下使用，生产环境不需要设置
VITE_LOCAL_IP=
