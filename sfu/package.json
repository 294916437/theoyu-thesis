{
	"name": "sfu-server-node",
	"version": "1.0.0",
	"description": "SFU Server based on Mediasoup and Express",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "nodemon src/server.ts",
		"docker:build": "docker build -t sfu-server:latest ."
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.1",
		"@grpc/proto-loader": "^0.8.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^5.2.1",
		"mediasoup": "^3.19.12",
		"mediasoup-client": "^3.18.1",
		"nacos-naming": "^2.6.0",
		"socket.io": "^4.8.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^20.12.7",
		"@types/socket.io": "^3.0.2",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.0",
		"copyfiles": "^2.4.1",
		"cross-env": "^7.0.3",
		"nodemon": "^3.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"nodemonConfig": {
		"watch": [
			"src"
		],
		"ext": "ts",
		"ignore": [
			"src/**/*.spec.ts"
		],
		"exec": "ts-node src/server.ts",
		"env": {
			"NODE_ENV": "development"
		}
	}
}
