# Server Configuration
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Mediasoup Configuration
MEDIASOUP_WORKERS=4
MEDIASOUP_LOG_LEVEL=debug
MEDIASOUP_LISTEN_IP=0.0.0.0
# Replace with your public IP address
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051
GRPC_SERVER_PORT=50052
GRPC_SERVICE_NAME=video-conference-service

# Nacos Configuration
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=thesis
NACOS_SERVICE_NAME=sfu-server
NACOS_IP=127.0.0.1
NACOS_PORT=3000

# MinIO Configuration
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test123456